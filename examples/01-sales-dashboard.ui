root=Column([Heading("Revenue reached $42,800",level:1),Grid([Stat("Revenue",42800,delta:12,format:"currency"),Stat("Orders",324,delta:8),Stat("Average order",132.1,format:"currency"),Stat("Conversion",3.2,format:"percent")],cols:4),Card([trend],title:"Revenue trend"),Facts([{label:"Reporting period",value:"Last 30 days"},{label:"Region",value:"North America"}],columns:2)])
