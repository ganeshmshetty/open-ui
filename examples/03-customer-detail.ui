root=Column([Heading("Acme renewed for another year",level:1),Row([Badge("Active",tone:"success"),Badge("Enterprise")]),Grid([Stat("Annual value",120000,format:"currency"),Stat("Seats",250)],cols:2),Card([Facts([{label:"Contact",value:"Elena Ruiz"},{label:"Email",value:"elena@acme.example"},{label:"Renewal",value:"October 2027"},{label:"Owner",value:"Rohan Mehta"}],columns:2)],title:"Account details"),Button("Draft renewal summary",tone:"primary",on_click:say("Draft Acme's renewal summary"))])
