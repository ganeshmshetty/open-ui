root=Column([Heading("Update your public profile",level:1),Form([Input("Name",bind:$name,required:true,max_len:60),Input("Email",bind:$email,kind:"email",required:true),Button("Save profile",tone:"primary",submit:true)],on_submit:say("Update my profile",{name:$name,email:$email}))])
$name="Ada Patel"
$email="ada@example.com"
