root=Column([Heading("Two products need restocking",level:1),Grid([Stat("Active products",128),Stat("Low stock",2,good:"down")]),Table([TableColumn("Product","name"),TableColumn("SKU","sku"),TableColumn("In stock","stock",align:"end",format:"number"),TableColumn("Reorder at","minimum",align:"end",format:"number")],[{name:"Travel mug",sku:"MUG-02",stock:8,minimum:20},{name:"Notebook",sku:"NOTE-01",stock:12,minimum:30}]),Button("Prepare restock order",tone:"primary",on_click:say("Prepare a restock order for the low-stock products"))])
